# ==========================================================================
# Vitaloop UPA — exemplo de variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env real.
# Segredos de produção devem vir de um secret manager, não de arquivo.
# ==========================================================================

# Ambiente: development | homologation | production
ENVIRONMENT=development
LOG_LEVEL=info

# --- Banco de dados (PostgreSQL) ---
# Em produção/homologação cada ambiente possui seu próprio banco e credenciais.
DATABASE_URL=postgres://vitaloop_app:CHANGE_ME@localhost:5432/vitaloop_upa
# Role administrativa usada apenas por migrations/manutenção (nunca pela API).
DATABASE_MIGRATOR_URL=postgres://postgres:CHANGE_ME@localhost:5432/vitaloop_upa

# --- Autenticação / Sessão ---
# Segredo para assinatura de tokens de sessão (>= 32 bytes aleatórios).
AUTH_SECRET=CHANGE_ME_use_a_long_random_value
# Timeout de sessão por inatividade (minutos).
SESSION_IDLE_TIMEOUT_MINUTES=30
# Máximo de dispositivos simultâneos por usuário (regra do Master).
SESSION_MAX_DEVICES=2
# Dias sem atividade após os quais o usuário é inativado (6 meses).
USER_INACTIVITY_DAYS=180

# --- API ---
API_HOST=0.0.0.0
API_PORT=3333
CORS_ORIGIN=http://localhost:5173

# --- Armazenamento de arquivos (PDFs, imagens de exame) ---
STORAGE_DRIVER=filesystem
STORAGE_ROOT=./.storage

# --- Geração de PDF ---
PDF_INSTITUTION_NAME=UPA Municipal
PDF_TEMPLATE_VERSION=1
